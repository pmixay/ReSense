+    """21.10 (F1a bounded, ``lowobj.rail_head_bounded``): the rail head's own top at low cluster ``c``, from evidence
+    the cluster's object cannot supply alone. ``X``, ``dy``, ``h``: the low-free returns (:func:`low_free_mask`);
+    ``d0``, ``d1``: the cluster's own lateral extent. Only for a cluster at most ``rail_start_max_width`` wide whose
+    extent reaches exactly one rail line within ``rail_start_lateral``. Four regions, each the highest return with
+    -0.3 < h < ``foot_max_top`` in a rail's band (``local_rail_band``) within ``local_rail_window`` along the track:
+    its own rail before ``x0`` - 0.3 and after ``x1`` + 0.3 (its own extent and guard excluded), the other rail
+    before and after the cluster's centre. Each rail's level is the lower of its two regions (a slope raises the far
+    region of each pair only, a local rise or a stray return one region); revision 2: the two rails' levels must
+    agree within ``rail_head_rails_tol`` (cant, or an object along one rail, makes them differ) and the head top is
+    the lower level. None (no rejection) when a region has no return, the rails disagree, or the result is more than
+    ``rail_head_max_above_plane`` above the model plane."""
+    half, tol = 0.5 * float(rails_spacing), float(cfg.rail_start_lateral)
+    if float(c.size[1]) > cfg.rail_start_max_width:
+        return None
+    sides = [s for s in (-1.0, 1.0) if d0 <= s * half + tol and d1 >= s * half - tol]
+    if len(sides) != 1:
+        return None
+    s, w, guard, band = sides[0], float(cfg.local_rail_window), 0.3, float(cfg.local_rail_band)
+    x0, x1 = float(c.bbox_min[0]), float(c.bbox_max[0])
+    xc = 0.5 * (x0 + x1)
+    ok = (h > -0.3) & (h < cfg.foot_max_top)
+    own = ok & (np.abs(dy - s * half) <= band)
+    other = ok & (np.abs(dy + s * half) <= band)
+    tops = []
+    for m, lo, hi in ((own, x0 - w, x0 - guard), (own, x1 + guard, x1 + w), (other, x0 - w, xc), (other, xc, x1 + w)):
+        k = m & (X >= lo) & (X <= hi)
+        if not k.any():
+            return None
+        tops.append(float(h[k].max()))
+    own_level, other_level = min(tops[:2]), min(tops[2:])
+    if abs(own_level - other_level) > cfg.rail_head_rails_tol:
+        return None
+    head = min(own_level, other_level)
+    return head if head <= cfg.rail_head_max_above_plane else None
+
+
+def _faces_sensor(X: np.ndarray, dy: np.ndarray, h: np.ndarray, footprint: np.ndarray, cfg: LowObjectConfig) -> bool:
+    """21.10 (F1a bounded, revision 2): two footprint returns at the same place along the track (within
+    ``rail_head_face_dx``) and across it (within ``rail_head_face_dy``), 0.03-0.30 m apart in height: one ring is a
+    cone of near-constant elevation, so returns at one range and different heights come from different rings - a
+    face toward the sensor (an obstacle's front), which a continuous rail head never shows (its next ring lands
+    metres further along). ``rail_head_face_dy`` admits the real sensor's per-ring azimuth phases (review
+    2026-10-21: neighbours 5.8 cm apart on a real box front)."""
