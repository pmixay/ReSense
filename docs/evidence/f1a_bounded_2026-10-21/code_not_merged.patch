diff --git a/tests/test_f1a_bounded.py b/tests/test_f1a_bounded.py
new file mode 100644
index 0000000..3e48b34
--- /dev/null
+++ b/tests/test_f1a_bounded.py
@@ -0,0 +1,271 @@
+"""21.10 F1a bounded head top (``lowobj.rail_head_bounded``; docs/evidence/f1a_bounded_2026-10-21).
+
+The B1 repair's uncapped top reads the rail head's own top surface on the ride and reports it as an object's body
+(ride events 18 -> 23). The rejected completion read that surface as a +-5 m maximum, which an object's own top, a
+slope or a local rise could supply (independent review, F1-F4). The bounded head top is the lowest of four maxima
+(own rail before / after the cluster's extent, other rail before / after its centre), so an object must cover all
+four regions to raise it. The defect test fails with the switch off; every control must keep the object."""
+from __future__ import annotations
+
+import dataclasses
+
+import numpy as np
+import pytest
+
+from resense.clustering import Cluster
+from resense.config import LowObjectConfig
+from resense.lowobj import low_free_mask, rail_head_top, rail_reference_check
+
+HALF = 0.5 * 1.59
+SPACING = 1.59
+
+
+def _cfg(on=True, **kw):
+    return dataclasses.replace(LowObjectConfig(), rail_head_bounded=on, **kw)
+
+
+def _scene(head=0.20, head_other=None, web=0.05, head_step=2.0, slope=0.0, x_lo=30.0, x_hi=50.0,
+           own_head=None, other_head=None):
+    """Both rails: web/foot returns every 0.4 m at ``web`` (inside the rail band, 5 cm off the line) and head-top
+    returns on the line every ``head_step`` m (a ring crossing) at ``head`` + slope * (x - 40) (other rail:
+    ``head_other``, default the same). ``own_head`` / ``other_head``: explicit head-top x positions. Bed at -0.15."""
+    head_other = head if head_other is None else head_other
+    X, dy, h = [], [], []
+    xs = np.arange(x_lo, x_hi, 0.4)
+    for s in (1.0, -1.0):
+        X += list(xs)
+        dy += [s * HALF + 0.05] * xs.size
+        h += [web] * xs.size
+        hx = np.arange(x_lo, x_hi, head_step) if (own_head if s > 0 else other_head) is None \
+            else np.asarray(own_head if s > 0 else other_head, float)
+        X += list(hx)
+        dy += [s * HALF] * hx.size
+        h += list((head if s > 0 else head_other) + slope * (hx - 40.0))
+    X += list(xs)
+    dy += [0.0] * xs.size
+    h += [-0.15] * xs.size
+    return [np.asarray(X, float), np.asarray(dy, float), np.asarray(h, float)]
+
+
+def _add(sc, pts):
+    for x, d, v in pts:
+        sc[0], sc[1], sc[2] = np.r_[sc[0], x], np.r_[sc[1], d], np.r_[sc[2], v]
+    return sc
+
+
+def _fragment(sc, x0=40.0, length=0.3, lat=HALF, width=0.24, low=0.04, tops=((40.15, 0.0, 0.20),)):
+    """A narrow low cluster on a rail: two low returns at its lateral edges (capped top ``low``) and ``tops``
+    (x, dy offset from ``lat``, h) returns in its footprint above the low-stage floor (not cluster members)."""
+    i = sc[0].size
+    _add(sc, [(x0, lat - width / 2, low), (x0 + length, lat + width / 2, low)])
+    _add(sc, [(x, lat + d, v) for x, d, v in tops])
+    idx = np.array([i, i + 1])
+    c = Cluster(points_idx=idx, n=2, n_raw=2, centroid=np.array([x0 + length / 2, lat, low]),
+                bbox_min=np.array([x0, lat - width / 2, 0.0]), bbox_max=np.array([x0 + length, lat + width / 2, low]),
+                distance=x0, lateral=lat, height_min=0.0, height_max=low, intensity=10.0, n_expected=5.0, score=1.0,
+                zone="gauge", n_gauge=2, kind="low")
+    return sc, c
+
+
+def _rejected(sc, c, cfg, others=()):
+    X, dy, h = sc
+    clusters = [c, *others]
+    free = low_free_mask(X.size, clusters, X, dy)
+    return any(o is c for o in rail_reference_check(clusters, X, dy, h, cfg, SPACING, free))
+
+
+# --- the defect: the head's own top kept as an object's body ----------------------------------------------------
+
+@pytest.mark.parametrize("side", [1.0, -1.0])
+def test_rail_head_fragment_is_weak_again_with_the_switch(side):
+    sc, c = _fragment(_scene(), lat=side * HALF)
+    assert not _rejected(sc, c, _cfg(False)), "1.2.0 keeps it (the B1 cost)"
+    assert _rejected(sc, c, _cfg(True))
+
+
+@pytest.mark.parametrize("slope", [-0.01, -0.005, 0.005, 0.01])
+def test_rail_head_fragment_under_a_slope_is_weak(slope):
+    head = 0.20 + slope * 0.15
+    sc, c = _fragment(_scene(slope=slope), tops=((40.15, 0.0, head),))
+    assert _rejected(sc, c, _cfg(True))
+
+
+@pytest.mark.parametrize("slope", [-0.02, 0.02])
+def test_a_steep_head_with_sparse_crossings_fails_open(slope):
+    """The nearest head crossing of a region lies up to 2 m away: under 2 cm/m the lowest region is > 3 cm below the
+    fragment's own top, so the head is not recognised (the cost of the bound, not a hidden object)."""
+    head = 0.20 + slope * 0.15
+    sc, c = _fragment(_scene(slope=slope), tops=((40.15, 0.0, head),))
+    assert not _rejected(sc, c, _cfg(True))
+
+
+def test_the_head_top_is_the_lowest_of_four_regions():
+    sc, c = _fragment(_scene(head=0.20, head_other=0.18))
+    X, dy, h = sc
+    free = low_free_mask(X.size, [c], X, dy)
+    d = dy[c.points_idx]
+    assert rail_head_top(c, X[free], dy[free], h[free], d.min(), d.max(), _cfg(), SPACING) == pytest.approx(0.18)
+
+
+# --- an object must stay an object ---------------------------------------------------------------------------------
+
+@pytest.mark.parametrize("delta", [0.05, 0.10, 0.15, 0.20])
+@pytest.mark.parametrize("side", [1.0, -1.0])
+def test_object_above_the_head_is_kept(delta, side):
+    """Also when a head crossing lies inside the footprint (x = 40.0, 0.20) and the object's top is at or above
+    foot_max_top (0.35: deltas 0.15 and 0.20), where the uncapped top is the head crossing itself."""
+    sc, c = _fragment(_scene(), lat=side * HALF, tops=((40.15, 0.0, 0.20 + delta),))
+    assert not _rejected(sc, c, _cfg(True))
+
+
+@pytest.mark.parametrize("cover", ["after", "before", "both"])
+def test_an_objects_own_returns_along_its_rail_cannot_define_the_head(cover):
+    """A long object (top 0.30, 10 cm above the 0.20 head) whose unclustered top returns lie on its own rail line
+    beyond its low fragment: it raises the own-rail regions it covers, never the other rail."""
+    xs = {"after": np.arange(40.6, 45.0, 0.2), "before": np.arange(35.2, 39.7, 0.2),
+          "both": np.r_[np.arange(35.2, 39.7, 0.2), np.arange(40.6, 45.0, 0.2)]}[cover]
+    sc = _add(_scene(), [(x, HALF, 0.30) for x in xs])
+    sc, c = _fragment(sc, tops=((40.15, 0.0, 0.30),))
+    assert not _rejected(sc, c, _cfg(True))
+
+
+@pytest.mark.parametrize("region", ["own_before", "own_after", "other_before", "other_after"])
+def test_head_seen_in_three_regions_only_does_not_reject(region):
+    """Every region must see the rail; a region with web/foot returns only gives a low head top (fail-open)."""
+    own_b, own_a = np.arange(30.0, 39.7, 2.0), np.arange(41.0, 50.0, 2.0)
+    oth_b, oth_a = np.arange(30.0, 40.1, 2.0), np.arange(40.3, 50.0, 2.0)
+    own = {"own_before": own_a, "own_after": own_b}.get(region, np.r_[own_b, own_a])
+    oth = {"other_before": oth_a, "other_after": oth_b}.get(region, np.r_[oth_b, oth_a])
