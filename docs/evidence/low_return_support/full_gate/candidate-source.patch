diff --git a/tests/test_low_ray_support.py b/tests/test_low_ray_support.py
new file mode 100644
index 0000000..16f3e45
--- /dev/null
+++ b/tests/test_low_ray_support.py
@@ -0,0 +1,109 @@
+"""Low-stage density support must count acquisition rays, never duplicate echoes."""
+from dataclasses import replace
+
+import numpy as np
+import pytest
+
+from resense.clustering import find_clusters, voxelize
+from resense.config import DetectorConfig
+from resense.detector import Candidates, Detector
+from resense.frame import sensor_to_vehicle
+
+
+# Three real v2 development returns: three columns, but two range-scaled cells.
+XYZ = np.array([[50.029274, 1.047964, -1.250048],
+                [50.023354, 1.135189, -1.249948],
+                [49.998894, 1.221947, -1.249388]], dtype=np.float32)
+KEYS = np.array([[52, -888], [52, -887], [52, -886]])
+
+
+def clusters(xyz=XYZ, keys=KEYS, *, low=True, height=0.068, indices=None, low_cfg=None):
+    cfg = DetectorConfig()
+    n = len(xyz)
+    return find_clusters(xyz, np.ones(n), xyz[:, 1] - 0.25,
+                         np.full(n, height), np.ones(n, bool),
+                         replace(cfg.cluster, eps=cfg.lowobj.eps),
+                         frame_idx=indices, low=np.ones(n, bool),
+                         low_cfg=(low_cfg or cfg.lowobj) if low else None,
+                         low_ray_keys=keys)
+
+
+def test_three_columns_recover_low_object_without_lowering_density_bars():
+    cfg = DetectorConfig()
+    assert len(voxelize(XYZ, cfg.cluster)[0]) == 2
+    assert cfg.cluster.min_samples == cfg.lowobj.min_points == 3
+    assert not clusters(keys=None)
+    actual = clusters()
+    assert len(actual) == 1 and actual[0].n == 3 and actual[0].kind == 'low'
+    assert actual[0].points_idx.tolist() == [0, 1, 2]
+
+
+@pytest.mark.parametrize('copies', [1, 2, 20])
+def test_duplicate_echoes_cannot_supply_a_third_ray(copies):
+    xyz = np.repeat(XYZ[:2], copies, axis=0)
+    keys = np.repeat(KEYS[:2], copies, axis=0)
+    assert not clusters(xyz, keys)
+
+
+@pytest.mark.parametrize('case', ['historical', 'unknown_ring', 'too_narrow', 'below_top', 'corridor'])
+def test_extra_support_preserves_current_geometry_and_path_guards(case):
+    xyz, keys, kwargs = XYZ.copy(), KEYS.copy(), {}
+    if case == 'historical':
+        kwargs['indices'] = np.array([0, 1, -1])
+    elif case == 'unknown_ring':
+        keys[2, 0] = -1
+    elif case == 'too_narrow':
+        xyz[:, 1] = 1.10 + np.arange(3) * 0.03
+    elif case == 'below_top':
+        kwargs['height'] = -0.01
+    elif case == 'corridor':
+        kwargs['low'] = False
+    assert not clusters(xyz, keys, **kwargs)
+
+
+def test_existing_cluster_is_unchanged_by_extra_ray_support():
+    xyz = XYZ.copy()
+    xyz[:, 1] -= 0.87  # same object, three separate original cells
+    assert len(voxelize(xyz, DetectorConfig().cluster)[0]) == 3
+    before, after = clusters(xyz, None), clusters(xyz, KEYS)
+    assert len(before) == len(after) == 1
+    assert before[0].n == after[0].n == 3
+    assert np.array_equal(before[0].points_idx, after[0].points_idx)
+    assert np.array_equal(before[0].centroid, after[0].centroid)
+
+
+def test_ray_keys_ignore_fixed_and_automatic_mount_corrections():
+    cfg = DetectorConfig()
+    cfg.sensor.roll_deg, cfg.sensor.pitch_deg, cfg.sensor.yaw_deg = 3, -2, 7
+    det = Detector(cfg)
+    angle = np.radians(np.array([-88.8, -88.7, -88.6]))
+    raw = np.column_stack((50 * np.cos(angle), 50 * np.sin(angle), np.full(3, -1.25)))
+    det._frame_xyz = sensor_to_vehicle(raw, cfg.sensor)
+    current = dict(dy=np.zeros(3), h=np.ones(3), in_gauge=np.ones(3, bool),
+                   intensity=np.ones(3), idx=np.arange(3), low=np.ones(3, bool),
+                   ring=np.full(3, 52))
+    before = det._low_ray_keys(Candidates(xyz=det._frame_xyz, **current))
+    from resense.calibration import rot_x, rot_y, rot_z
+    correction = rot_z(0.12) @ rot_y(-0.05) @ rot_x(0.08)
+    after = det._low_ray_keys(Candidates(xyz=det._frame_xyz @ correction.T, **current))
+    expected = np.column_stack((np.full(3, 52), np.arange(3)))
+    assert np.array_equal(before, expected)
+    assert np.array_equal(after, expected)
+
+
+def test_echoes_straddling_a_nominal_column_boundary_still_count_once():
+    cfg = DetectorConfig()
+    det = Detector(cfg)
+    # Two rays; one dual echo straddles the arbitrary fixed-grid rounding boundary.
+    angle = np.radians([-88.8501, -88.8499, -88.65])
+    radius = np.array([50.0, 50.01, 50.0])
+    raw = np.column_stack((radius * np.cos(angle), radius * np.sin(angle), np.full(3, -1.25)))
+    xyz = sensor_to_vehicle(raw, cfg.sensor)
+    det._frame_xyz = xyz
+    cand = Candidates(xyz=xyz, dy=xyz[:, 1] - 0.25, h=np.full(3, 0.068),
+                      in_gauge=np.ones(3, bool), intensity=np.ones(3), idx=np.arange(3),
+                      low=np.ones(3, bool), ring=np.full(3, 52))
+    keys = det._low_ray_keys(cand)
+    assert np.unique(keys, axis=0).shape[0] == 2
+    assert len(voxelize(xyz, cfg.cluster)[0]) == 2
+    assert not clusters(xyz, keys)
