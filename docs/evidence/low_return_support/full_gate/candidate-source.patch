+    def _low_ray_keys(self, cand: Candidates) -> Optional[np.ndarray]:
+        """Current acquisition ray groups, before fixed or automatic mount correction.
+
+        Recover sensor coordinates only for selected low points. Historical points
+        and missing channels cannot supply extra support; duplicate echoes share a key.
+        """
+        if self._frame_xyz is None or cand.ring is None:
+            return None
+        keys = np.full((len(cand), 2), -1, dtype=np.int64)
+        current = (cand.idx >= 0) & (cand.ring >= 0)
+        raw = self._frame_xyz[cand.idx[current]] @ axis_matrix(self.cfg.sensor)
+        if not current.any():
+            return keys
+        selected = np.flatnonzero(current)
+        rings = cand.ring[current]
+        angle = np.arctan2(raw[:, 1], raw[:, 0])
+        order = np.lexsort((angle, rings))
+        # No fixed grid origin: ring calibration can offset the azimuth lattice.
+        # The full centimetre cache step bounds XY quantisation error conservatively;
+        # echoes whose angular intervals overlap cannot count as separate rays.
+        error = np.arcsin(np.minimum(1.0, COMPACT16_SCALE / np.linalg.norm(raw[:, :2], axis=1)))
+        gaps = np.diff(angle[order])
+        separate = ((np.diff(rings[order]) != 0)
+                    | (gaps > np.radians(AZIMUTH_STEP_DEG / 2) + error[order][1:] + error[order][:-1]))
+        keys[selected, 0] = rings
+        keys[selected[order], 1] = np.cumsum(np.r_[True, separate]) - 1
+        return keys
