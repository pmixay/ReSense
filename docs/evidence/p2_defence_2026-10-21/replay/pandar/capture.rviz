Panels:
- Class: rviz_common/Displays
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /Detections1
    Splitter Ratio: 0.5
  Tree Height: 560
- Class: rviz_common/Views
  Name: Views
  Expanded:
  - /Current View1
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 10
    Plane Cell Count: 40
    Plane: XY
    Line Style:
      Line Width: 0.03
      Value: Lines
    Color: 60; 62; 72
    Alpha: 0.5
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: -100
      Z: -2
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: rviz_default_plugins/PointCloud2
    Name: LiDAR (/lidar_points)
    Enabled: true
    Topic:
      Value: /sensing/lidar/hesai128/pointcloud
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Position Transformer: XYZ
    Color Transformer: AxisColor
    Axis: Z
    Use Fixed Frame: true
    Autocompute Value Bounds:
      Max Value: 3.5
      Min Value: -2.5
      Value: false
    Min Color: 0; 0; 0
    Max Color: 255; 255; 255
    Alpha: 0.7
    Decay Time: 0
    Selectable: true
    Size (Pixels): 1.5
    Size (m): 0.05
    Style: Points
    Value: true
  - Class: rviz_default_plugins/PointCloud2
    Name: LiDAR (/sensing/lidar/hesai128/pointcloud)
    Enabled: false
    Topic:
      Value: /sensing/lidar/hesai128/pointcloud
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Position Transformer: XYZ
    Color Transformer: AxisColor
    Axis: Z
    Use Fixed Frame: true
    Autocompute Value Bounds:
      Max Value: 3.5
      Min Value: -2.5
      Value: false
    Min Color: 0; 0; 0
    Max Color: 255; 255; 255
    Alpha: 0.7
    Decay Time: 0
    Selectable: true
    Size (Pixels): 1.5
    Size (m): 0.05
    Style: Points
    Value: true
  - Class: rviz_default_plugins/PointCloud2
    Name: Corridor points
    Enabled: true
    Topic:
      Value: /resense/corridor_points
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Position Transformer: XYZ
    Color Transformer: FlatColor
    Use Fixed Frame: true
    Color: 255; 170; 0
    Alpha: 1
    Decay Time: 0
    Selectable: true
    Size (Pixels): 4
    Size (m): 0.1
    Style: Points
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Name: Detections
    Enabled: true
    Topic:
      Value: /resense/markers
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Namespaces:
      resense: true
    Value: true
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: false
    Show Arrows: false
    Show Axes: true
    Show Names: true
    Marker Scale: 3
    Update Interval: 0
    Frame Timeout: 15
    Value: false
  Global Options:
    Background Color: 12; 13; 18
    Fixed Frame: resense_lidar
    Frame Rate: 30
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Distance: 55
      Focal Point:
        X: 0
        Y: -35
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Near Clip Distance: 0.01
      Pitch: 0.27
      Yaw: 1.5708
      Value: Orbit (rviz)
    Saved:
    - Class: rviz_default_plugins/Orbit
      Name: Top-down 150 m
      Target Frame: <Fixed Frame>
      Distance: 160
      Focal Point:
        X: 0
        Y: -75
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Near Clip Distance: 0.01
      Pitch: 1.5
      Yaw: 1.5708
      Value: Orbit (rviz)
    - Class: rviz_default_plugins/Orbit
      Name: Driver's seat
      Target Frame: <Fixed Frame>
      Distance: 12
      Focal Point:
        X: 0
        Y: -10
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Near Clip Distance: 0.01
      Pitch: 0.12
      Yaw: 1.5708
      Value: Orbit (rviz)
Window Geometry:
  Height: 1030
  Width: 1400
  Displays:
    collapsed: false
  Views:
    collapsed: false
  Hide Left Dock: true
  Hide Right Dock: true
  X: 0
  Y: 0
