diff --git a/tests/test_far_axis.py b/tests/test_far_axis.py
new file mode 100644
index 0000000..0582dd0
--- /dev/null
+++ b/tests/test_far_axis.py
@@ -0,0 +1,186 @@
+"""Learned far axis (22.10, ``track.learned_far_axis``; docs/evidence/ml_far_axis_2026-10-22): acceptance tests
+written before any measuring run. Off by default in the code and both parameter files; off means byte-identical
+detector outputs; the numpy evaluator equals scikit-learn; the learned centreline is only used where its band is
+narrow, contiguously from ``learned_far_axis_from``, never shortens the trusted range and never enters the K2 curve
+pass; off whenever farrange is on unless asked."""
+
+import json
+from dataclasses import replace
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+from resense import far_axis as fa
+from resense.config import DetectorConfig
+from resense.detector import Detector
+from resense.frame import Frame
+from tests.test_wall_drift import _entry_scene
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def _const_model(mid=0.0, band=0.2, path=None):
+    """A model whose three quantiles are constants (one leaf each): lower mid - band/2, middle mid, upper mid + band/2."""
+    leaf = lambda v: {"feature": [0], "threshold": [0.0], "left": [-1], "right": [-1], "value": [v],  # noqa: E731
+                      "missing_left": [0]}
+    spec = {"features": list(fa.FEATURES), "quantiles": [0.05, 0.5, 0.95], "query_x": fa.QUERY_X.tolist(),
+            "models": [{"baseline": 0.0, "trees": [leaf(mid - band / 2)]}, {"baseline": 0.0, "trees": [leaf(mid)]},
+                       {"baseline": 0.0, "trees": [leaf(mid + band / 2)]}]}
+    if path is not None:
+        Path(path).write_text(json.dumps(spec))
+    return spec
+
+
+def _cfg(**kw):
+    c = DetectorConfig()
+    return replace(c, track=replace(c.track, **kw))
+
+
+def _run(cfg, xyz, n=10):
+    det = Detector(cfg)
+    out = [det.process(Frame(xyz=xyz, intensity=np.full(len(xyz), 30.0, np.float32), stamp=0.1 * k)) for k in range(n)]
+    return det, out
+
+
+def _rows(results):
+    return [(r.obstacle, r.warning, r.nearest_distance, r.clear_distance, r.track.to_dict(),
+             [(d.id, round(d.distance, 6), round(d.lateral, 6), d.zone, d.reason) for d in r.detections],
+             [(d.id, round(d.distance, 6), round(d.lateral, 6), d.zone, d.reason) for d in r.warnings],
+             r.health.get("monitored_range")) for r in results]
+
+
+def test_off_by_default_in_code_and_both_parameter_files():
+    for cfg in (DetectorConfig(), DetectorConfig.from_yaml(str(ROOT / "configs/default.yaml")),
+                DetectorConfig.from_yaml(str(ROOT / "ros2_ws/src/resense_ros/config/detector.yaml"))):
+        t = cfg.track
+        assert t.learned_far_axis is False
+        assert (t.learned_far_axis_model, t.learned_far_axis_from, t.learned_far_axis_max_band,
+                t.learned_far_axis_falcon) == ("far_axis_1.3.json", 40.0, 0.5, False)
+    assert Detector(DetectorConfig()).learned is None
+
+
+def test_evaluator_equals_sklearn():
+    from sklearn.ensemble import HistGradientBoostingRegressor
+    sys_path = ROOT / "docs/evidence/ml_far_axis_2026-10-22/scripts"
+    import sys
+    sys.path.insert(0, str(sys_path))
+    from fa_train import export
+    r = np.random.default_rng(0)
+    X = r.normal(size=(2000, len(fa.FEATURES)))
+    X[r.random(X.shape) < 0.1] = np.nan
+    y = np.nan_to_num(X[:, 0]) * 0.3 + np.nan_to_num(X[:, 5]) ** 2 + r.normal(0, 0.1, 2000)
+    ms = [HistGradientBoostingRegressor(loss="quantile", quantile=q, max_iter=30, random_state=0).fit(X, y)
+          for q in (0.05, 0.5, 0.95)]
+    spec = export(ms, fa.FEATURES, (0.05, 0.5, 0.95), fa.QUERY_X)
+    M = fa.FarAxisModel(spec)
+    sk = np.sort(np.stack([m.predict(X) for m in ms], 1), axis=1)
+    assert np.max(np.abs(M.predict_raw(X) - sk)) < 1e-9
+    # the conformal margins widen the band at the row's query distance, the middle is untouched
+    spec["margin"] = list(np.linspace(0.1, 2.0, fa.QUERY_X.size))
+    M = fa.FarAxisModel(spec)
+    X[:, fa.FEATURES.index("x")] = 145.0
+    Q = M.predict(X)
+    m = np.interp(145.0, fa.QUERY_X, spec["margin"])
+    assert np.allclose(Q[:, 1], M.predict_raw(X)[:, 1]) and np.allclose(Q[:, 2] - Q[:, 0],
+                                                                       np.diff(M.predict_raw(X)[:, [0, 2]], axis=1)[:, 0] + 2 * m)
+
+
+def test_learned_axis_trusts_only_a_contiguous_narrow_band():
+    M = fa.FarAxisModel(_const_model(0.3, 0.2))
+    prof = tuple(np.zeros((fa.NBINS, int(2 * w / fa.DYB)), np.uint16) for w in (fa.SIDE_W, fa.VAULT_W, fa.BED_W))
+    st = {"center": 0.0, "tan_yaw": 0.0, "curv": 0.0, "curv_step": 0.0, "curv_knot": 0.0, "axis_valid": 120.0,
+          "rail_slabs": 3, "axis_sides": 2, "wall_quality": 0.1}
+    la, q = fa.learned_axis(M, prof, st, 40.0, 0.5, 250.0)
+    assert la.to_x == 250.0 and np.allclose(q[:, 1], 0.3)
+    X = np.array([10.0, 40.0, 50.0, 60.0, 100.0, 250.0, 251.0])
+    off = la.offset(X)
+    assert off[0] == 0.0 and off[1] == 0.0 and off[-1] == 0.0          # nothing before from_x or beyond to_x
+    assert 0.0 < off[2] < 0.3 and off[3] == pytest.approx(0.3) and off[4] == pytest.approx(0.3)   # blended over 20 m
+    la, _ = fa.learned_axis(fa.FarAxisModel(_const_model(0.3, 0.6)), prof, st, 40.0, 0.5, 250.0)
+    assert la.to_x == 0.0 and not np.any(la.offset(X))                  # band too wide: nowhere
+
+
+def test_profile_and_follower_find_a_drifting_corridor():
+    from resense.track import TrackModel
+    tr = TrackModel(floor_coef=np.array([0.0, 0.0, -1.6]), floor_range=(3.0, 120.0), center=0.0, yaw=0.0, curvature=0.0)
+    X = np.repeat(np.arange(0.5, 250, 0.5), 10)
+    yt = 1e-5 * X ** 2                                                  # the true track bends left of the model
+    walls = [np.stack([X, yt + s * 2.2, np.full(X.size, -0.5)], 1) for s in (1.0, -1.0)]
+    prof = fa.profile(np.concatenate(walls).astype(np.float32), tr)
+    side = prof[0]
+    assert side.shape == (fa.NBINS, int(2 * fa.SIDE_W / fa.DYB)) and side.sum() > 0
+    fo = fa.follow(side)
+    xc = (np.arange(fa.NBINS) + 0.5) * fa.BIN
+    ok = np.isfinite(fo["cen"])
+    assert fo["last"] >= 240 and np.max(np.abs(fo["cen"][ok] - 1e-5 * xc[ok] ** 2)) < 0.12
+    F = fa.query_features(prof, {"center": 0.0, "tan_yaw": 0.0, "curv": 0.0, "curv_step": 0.0, "curv_knot": 0.0,
+                                 "axis_valid": 150.0, "rail_slabs": 3, "axis_sides": 2, "wall_quality": 0.1})
+    i = list(fa.QUERY_X).index(200.0)
+    assert F[i, fa.FEATURES.index("f_cen")] == pytest.approx(0.4, abs=0.12)
+
+
+def test_on_with_inert_model_equals_off_and_wide_band_is_inert(tmp_path):
+    xyz = _entry_scene(2e-5)[0]
+    off = _rows(_run(_cfg(), xyz)[1])
+    _const_model(0.0, 0.8, tmp_path / "wide.json")                      # band wider than max_band: never trusted
+    det, res = _run(_cfg(learned_far_axis=True, learned_far_axis_model=str(tmp_path / "wide.json")), xyz)
+    assert det.learned is not None and det._learned is not None and det._learned.to_x == 0.0
+    assert _rows(res) == off
+
+
+def test_on_with_narrow_zero_model_only_extends_trust(tmp_path):
+    xyz = _entry_scene(2e-5)[0]
+    base_det, base = _run(_cfg(), xyz)
+    _const_model(0.0, 0.2, tmp_path / "zero.json")                      # predicts the base axis, narrow band
+    det, res = _run(_cfg(learned_far_axis=True, learned_far_axis_model=str(tmp_path / "zero.json")), xyz)
+    assert det._learned.to_x == 250.0
+    for a, b in zip(base, res):
+        assert b.health.get("monitored_range", 0) >= a.health.get("monitored_range", 0) - 1e-9
+
+
+def test_learned_offset_moves_the_laterals_beyond_from(tmp_path):
+    xyz = _entry_scene(2e-5)[0]
+    _const_model(0.5, 0.2, tmp_path / "shift.json")
+    det = Detector(_cfg(learned_far_axis=True, learned_far_axis_model=str(tmp_path / "shift.json")))
+    det.process(Frame(xyz=xyz, intensity=np.full(len(xyz), 30.0, np.float32), stamp=0.0))
+    pts = np.array([[20.0, 0.0, 0.0], [100.0, 0.0, 0.0]], np.float32)
+    off = det._learned.offset(pts[:, 0].astype(np.float64))
+    assert off[0] == 0.0 and off[1] == pytest.approx(0.5)
+
+
+def test_curve_pass_never_sees_the_learned_offset(tmp_path, monkeypatch):
+    xyz = _entry_scene(2e-5)[0]
+    _const_model(0.5, 0.2, tmp_path / "shift.json")
+    det = Detector(_cfg(learned_far_axis=True, learned_far_axis_model=str(tmp_path / "shift.json")))
+    seen = []
+    orig = Detector._corridor
+
+    def spy(self, *a, **k):
+        seen.append((self.track.curve is None and self._learned is None, self._learned is not None))
+        return orig(self, *a, **k)
+    monkeypatch.setattr(Detector, "_corridor", spy)
+    for k in range(12):
+        det.process(Frame(xyz=xyz, intensity=np.full(len(xyz), 30.0, np.float32), stamp=0.1 * k))
+    # every corridor call either is the base pass with the learned offset, or the curve pass without it
+    curve_calls = [s for s in seen if s[0]]
+    base_calls = [s for s in seen if s[1]]
+    assert base_calls and curve_calls and len(base_calls) + len(curve_calls) == len(seen)
+    assert det._learned is not None                                      # restored after a curve pass
+
+
+def test_off_while_farrange_on_unless_asked(tmp_path):
+    _const_model(0.0, 0.2, tmp_path / "m.json")
+    c = _cfg(learned_far_axis=True, learned_far_axis_model=str(tmp_path / "m.json"))
+    c = replace(c, farrange=replace(c.farrange, enabled=True, axis_enabled=True))
+    assert Detector(c).learned is None
+    c = replace(c, track=replace(c.track, learned_far_axis_falcon=True))
+    assert Detector(c).learned is not None
