diff --git a/resense/far_axis.py b/resense/far_axis.py
new file mode 100644
index 0000000..7002852
--- /dev/null
+++ b/resense/far_axis.py
@@ -0,0 +1,416 @@
+"""A learned far track axis (22.10, ``track.learned_far_axis``; off by default).
+
+The track model (``resense/track.py``) is a parabola anchored at the sensor: its tangent comes from the rails at
+4-30 m, its curvature from the tunnel boundaries. Beyond ~120-150 m and on curves it is an extrapolation, and the
+gauge laid along it can pull side structures in (docs/evidence/false_stops_2026-10-21) or leave the track.
+
+This module predicts, per frame, the lateral offset of the true track centreline from that model at fixed
+distances ahead (``QUERY_X``), as three quantiles (a lower, a middle and an upper one), from what the frame
+observes: a per-5 m-bin profile of the tunnel boundaries on each side, the vault and the bed, measured in the
+coordinates of the model itself (:func:`profile`), and the model's own state (:func:`query_features`). The model is
+gradient-boosted quantile regression trained offline on the moving ride with self-supervised labels (the near-field
+rail pair of later frames brought back by odometry; docs/evidence/ml_far_axis_2026-10-22), stored as JSON and
+evaluated here with numpy (:class:`FarAxisModel`), as ``resense/opinion.py`` does.
+
+:func:`learned_axis` turns a prediction into a :class:`LearnedAxis`: the model's centreline is used for the laterals
+only from ``from_x`` (where the near model is no longer observed) to the farthest query distance whose predicted band
+is narrower than ``max_band``, contiguously; elsewhere nothing changes.
+"""
+from __future__ import annotations
+
+import json
+import os
+from dataclasses import dataclass
+from typing import List, Optional
+
+import numpy as np
+
+BIN = 5.0
+NBINS = 52                     # 0-260 m along the track
+DYB = 0.1                      # m, lateral histogram resolution
+SIDE_W, VAULT_W, BED_W = 25.0, 5.0, 3.0   # m, half-width of each lateral histogram around the base axis
+QUERY_X = np.arange(40.0, 251.0, 10.0)
+
+_SIDE_H = (0.4, 3.2)           # m above the rail head: walls, benches' faces, columns, cabinets
+_VAULT_H = 3.2                 # m above the rail head
+_BED_H = (-0.3, 0.35)
+
+
+def _hist(b: np.ndarray, dy: np.ndarray, half: float) -> np.ndarray:
+    nl = int(round(2 * half / DYB))
+    j = np.floor((dy + half) / DYB).astype(np.int64)
+    ok = (j >= 0) & (j < nl)
+    h = np.bincount(b[ok] * nl + j[ok], minlength=NBINS * nl).reshape(NBINS, nl)
+    return np.minimum(h, 65535).astype(np.uint16)
+
+
+def profile(xyz: np.ndarray, model) -> tuple:
+    """The observation of a frame in the coordinates of ``model`` (the detector's track model of the same frame):
+    per 5 m bin along X, lateral histograms (0.1 m) of dy = Y - model.center_y(X) for the returns 0.4-3.2 m above
+    the rail head (tunnel boundaries: walls, benches, columns, cabinets; +-25 m), above 3.2 m (the vault; +-5 m) and
+    -0.3-0.35 m (bed and rails; +-3 m). Returns (side, vault, bed) uint16 arrays."""
+    X = xyz[:, 0].astype(np.float64)
+    keep = (X > 0.0) & (X < BIN * NBINS)
+    X = X[keep]
+    dy = xyz[keep, 1] - model.center_y(X)
+    h = xyz[keep, 2] - model.rail_z(X)
+    b = (X / BIN).astype(np.int64)
+    side = (h > _SIDE_H[0]) & (h < _SIDE_H[1])
+    vault = h > _VAULT_H
+    bed = (h > _BED_H[0]) & (h < _BED_H[1])
+    return (_hist(b[side], dy[side], SIDE_W), _hist(b[vault], dy[vault], VAULT_W), _hist(b[bed], dy[bed], BED_W))
+
+
+def _centres(half: float) -> np.ndarray:
+    return -half + DYB * (np.arange(int(round(2 * half / DYB))) + 0.5)
+
+
+_YS, _YV, _YB = _centres(SIDE_W), _centres(VAULT_W), _centres(BED_W)
+
+
+def _hq(row: np.ndarray, ys: np.ndarray, lo: float, hi: float, q: float, min_n: int = 3) -> float:
+    """The q-quantile of the lateral positions histogrammed in ``row`` within (lo, hi); NaN with fewer than min_n."""
+    m = (ys > lo) & (ys < hi)
+    c = row[m].astype(np.float64)
+    n = c.sum()
+    if n < min_n:
+        return np.nan
+    k = np.searchsorted(np.cumsum(c), q * (n - 1) + 1)
+    return float(ys[m][min(k, c.size - 1)])
+
+
+def follow(side: np.ndarray, near_bins=(2, 8), lost_max: int = 3) -> dict:
+    """The tunnel corridor followed outward bin by bin from the near field (10-40 m): its centre's offset from the
+    base axis per bin (NaN where not followed), the sides that confirmed it, the near half-widths. A bin's prediction
+    is a weighted quadratic through the centres found so far (the near bins at 0: there the base axis rests on the
+    rails); each side's inner boundary (10 % quantile of the boundary returns 1.0-1.5 m beyond the expected
+    distance) must lie within 0.6 m of its near-field distance from the predicted centre; the corridor is lost after
+    ``lost_max`` bins without a side."""
+    wl = np.nanmedian([_hq(side[b], _YS, 1.25, 7.0, 0.1) for b in range(*near_bins)] + [np.nan])
+    wr = np.nanmedian([-_hq(side[b], _YS, -7.0, -1.25, 0.9) for b in range(*near_bins)] + [np.nan])
+    cen = np.full(NBINS, np.nan)
+    sides = np.zeros(NBINS, dtype=np.int64)
+    xs = list((np.arange(*near_bins) + 0.5) * BIN)
+    cs = [0.0] * len(xs)
+    lost, last = 0, near_bins[1] * BIN
+    if not (np.isfinite(wl) or np.isfinite(wr)):
+        return {"cen": cen, "sides": sides, "wl": wl, "wr": wr, "last": 0.0}
+    for b in range(near_bins[1], NBINS):
+        x = (b + 0.5) * BIN
+        xa, ca = np.array(xs[-12:]), np.array(cs[-12:])
+        deg = 2 if len(xa) >= 6 else 1
+        w = np.linspace(0.5, 1.0, len(xa))
+        cp = float(np.polyval(np.polyfit(xa, ca, deg, w=w), x))
+        sh, ns = [], 0
+        if np.isfinite(wl):
+            l_ = _hq(side[b], _YS, cp + 1.0, cp + wl + 1.5, 0.1)
+            if np.isfinite(l_) and abs(l_ - cp - wl) < 0.6:
+                sh.append(l_ - cp - wl); ns += 1
+        if np.isfinite(wr):
+            r_ = _hq(side[b], _YS, cp - wr - 1.5, cp - 1.0, 0.9)
+            if np.isfinite(r_) and abs(r_ - cp + wr) < 0.6:
+                sh.append(r_ - cp + wr); ns += 2
+        if sh:
+            c = cp + float(np.mean(sh))
+            cen[b], sides[b] = c, ns
+            xs.append(x); cs.append(c)
+            lost, last = 0, x
+        else:
+            lost += 1
+            if lost >= lost_max:
+                break
+    return {"cen": cen, "sides": sides, "wl": wl, "wr": wr, "last": last}
+
+
+def model_state(model, curve=None, far=None) -> dict:
+    """The track-model numbers the features read (base model, the K2 curve model when present, the far line)."""
+    st = {"center": float(model.center), "tan_yaw": float(np.tan(model.yaw)), "curv": float(model.curvature),
+          "curv_step": float(model.curv_step), "curv_knot": float(model.curv_knot),
+          "axis_valid": float(min(model.axis_valid, 1e4)), "rail_slabs": int(model.rail_slabs),
+          "axis_sides": int(model.axis_sides), "wall_quality": float(model.wall_quality),
+          "rail_score": float(model.rail_score), "age": int(model.age),
+          "wall_drift": float(min(model.wall_drift, 1e4)), "floor_hi": float(model.floor_range[1])}
+    if curve is not None:
+        st.update(curve_center=float(curve.center), curve_tan_yaw=float(np.tan(curve.yaw)),
+                  curve_curv=float(curve.curvature), curve_step=float(curve.curv_step),
+                  curve_knot=float(curve.curv_knot), curve_valid=float(min(curve.axis_valid, 1e4)),
+                  curve_from=float(curve.curve_from))
+    if far is not None:
+        st.update(far_join=float(far.join), far_y_join=float(far.y_join), far_slope=float(far.slope),
+                  far_valid=float(far.valid), far_lateral_to=float(far.lateral_to))
+    return st
+
+
+def _poly_y(c, t, k, step, knot, X):
+    X = np.asarray(X, dtype=np.float64)
+    return c + t * X + 0.5 * k * X * X + 0.5 * step * np.maximum(X - knot, 0.0) ** 2
+
+
+def base_y(st: dict, X) -> np.ndarray:
+    return _poly_y(st["center"], st["tan_yaw"], st["curv"], st["curv_step"], st["curv_knot"], X)
+
+
+def curve_offset(st: dict, X) -> np.ndarray:
+    """The K2 curve model minus the base model at X (0 without a curve model)."""
+    X = np.asarray(X, dtype=np.float64)
+    if "curve_center" not in st:
+        return np.zeros(X.shape)
+    return _poly_y(st["curve_center"], st["curve_tan_yaw"], st["curve_curv"], st["curve_step"], st["curve_knot"], X) \
+        - base_y(st, X)
+
+
+def far_offset(st: dict, X) -> np.ndarray:
+    """The far line minus the base model at X within the far line's lateral range (0 elsewhere or without one)."""
+    X = np.asarray(X, dtype=np.float64)
+    if "far_join" not in st:
+        return np.zeros(X.shape)
+    hi = max(st["far_valid"], st["far_lateral_to"])
+    on = (X > st["far_join"]) & (X <= hi)
+    return np.where(on, st["far_y_join"] + st["far_slope"] * (X - st["far_join"]) - base_y(st, X), 0.0)
+
+
+FEATURES = [
+    "x", "curv", "tan_yaw", "center", "curv_step", "axis_valid", "beyond_valid", "rail_slabs", "axis_sides",
+    "wall_quality", "has_curve", "curve_off", "curve_valid", "far_off", "base_bend",
+    # the boundaries near the query distance (+-1 bin), each relative to the same side's near-field (10-40 m) distance
+    "l_near", "r_near", "l_off", "r_off", "mid_off", "l_n", "r_n", "v_off", "v_n", "b_off", "b_n",
+    # the boundaries' midline over every observed bin (robust quadratic), evaluated at the query distance
+    "fit_at", "fit_slope_at", "fit_last", "fit_n", "beyond_last", "fit_res", "side_last_l", "side_last_r", "lin_at",
+    # the corridor followed outward (follow): its centre at X, how far it was followed, its extrapolations
+    "f_cen", "f_sides", "f_last", "beyond_f", "f_n", "f_quad", "f_lin", "f_slope", "f_res",
+]
+
+
+def _bin_stats(prof: tuple) -> np.ndarray:
+    """Per bin: left / right inner boundary (10 % quantile of |dy| in 1.25-7 m) and its count, vault and bed
+    median dy and counts: (NBINS, 8) = nl, l10, nr, r10, nv, v50, nb, b50."""
+    side, vault, bed = prof
+    out = np.full((NBINS, 8), np.nan)
+    ml, mr = (_YS > 1.25) & (_YS < 7.0), (_YS < -1.25) & (_YS > -7.0)
+    mv, mb = np.abs(_YV) < 4.0, np.abs(_YB) < 1.6
+    out[:, 0] = side[:, ml].sum(1)
+    out[:, 2] = side[:, mr].sum(1)
+    out[:, 4] = vault[:, mv].sum(1)
+    out[:, 6] = bed[:, mb].sum(1)
+    for b in range(NBINS):
+        if out[b, 0] >= 3:
+            out[b, 1] = _hq(side[b], _YS, 1.25, 7.0, 0.1)
+        if out[b, 2] >= 3:
+            out[b, 3] = -_hq(side[b], _YS, -7.0, -1.25, 0.9)
+        if out[b, 4] >= 3:
+            out[b, 5] = _hq(vault[b], _YV, -4.0, 4.0, 0.5)
+        if out[b, 6] >= 3:
+            out[b, 7] = _hq(bed[b], _YB, -1.6, 1.6, 0.5)
+    return out
+
+
+def _robust_quad(x, y, w):
+    A = np.stack([np.ones_like(x), x, x * x], 1)
+    sol = np.linalg.lstsq(A * w[:, None], y * w, rcond=None)[0]
+    r = y - A @ sol
+    s_ = 1.4826 * np.median(np.abs(r)) + 0.05
+    ww = w / (1.0 + (r / (2.5 * s_)) ** 2)
+    sol = np.linalg.lstsq(A * ww[:, None], y * ww, rcond=None)[0]
+    return sol, float(np.sqrt(np.average((y - A @ sol) ** 2, weights=ww)))
+
+
+def query_features(prof: tuple, st: dict, xq: np.ndarray = QUERY_X) -> np.ndarray:
+    """Feature rows (len(xq), len(FEATURES)) of one frame. NaN marks an unobserved value (the trees route it)."""
+    xq = np.asarray(xq, dtype=np.float64)
+    P = _bin_stats(prof)
+    xc = (np.arange(NBINS) + 0.5) * BIN
+    near = slice(2, 8)
+    okl, okr = P[near, 0] >= 5, P[near, 2] >= 5
+    lref = float(np.median(P[near, 1][okl])) if okl.any() else np.nan
+    rref = float(np.median(P[near, 3][okr])) if okr.any() else np.nan
+    lo = np.where(P[:, 0] >= 3, P[:, 1] - lref, np.nan)          # left boundary moved left (+) of its near distance
+    ro = np.where(P[:, 2] >= 3, -(P[:, 3] - rref), np.nan)       # right boundary moved left (+)
+    w = np.isfinite(lo).astype(float) + np.isfinite(ro).astype(float)
+    mid = np.where(w > 0, np.nansum(np.stack([lo, ro]), axis=0) / np.maximum(w, 1.0), np.nan)
+    use = np.isfinite(mid) & (xc > 12.0)
+    fit_c, fit_res = (np.nan, np.nan, np.nan), np.nan
+    fit_n, fit_last = int(use.sum()), (float(xc[use].max()) if use.any() else 0.0)
+    if fit_n >= 4:
+        fit_c, fit_res = _robust_quad(xc[use], mid[use], w[use])
+    lin = (np.nan, np.nan)
+    if fit_n >= 3:
+        far_ = use & (xc >= max(20.0, fit_last - 60.0))
+        if far_.sum() >= 3:
+            lin = tuple(np.polyfit(xc[far_], mid[far_], 1))
+    side_last_l = float(xc[np.isfinite(lo)].max()) if np.isfinite(lo).any() else 0.0
+    side_last_r = float(xc[np.isfinite(ro)].max()) if np.isfinite(ro).any() else 0.0
+    # the followed corridor
+    fo = follow(prof[0])
+    fc, fsd = fo["cen"], fo["sides"]
+    fok = np.isfinite(fc)
+    f_n, f_last = int(fok.sum()), float(fo["last"])
+    fq, f_res, fl = (np.nan, np.nan, np.nan), np.nan, (np.nan, np.nan)
+    if f_n >= 4:
+        xx = np.concatenate([xc[2:8], xc[fok]])
+        yy = np.concatenate([np.zeros(6), fc[fok]])
+        fq, f_res = _robust_quad(xx, yy, np.ones_like(xx))
+        tail = xc[fok] >= f_last - 40.0
+        if tail.sum() >= 3:
+            fl = tuple(np.polyfit(xc[fok][tail], fc[fok][tail], 1))
+    rows = []
+    co = curve_offset(st, xq)
+    fo_ = far_offset(st, xq)
+    bend = base_y(st, xq) - st["center"] - st["tan_yaw"] * xq
+    for i, x in enumerate(xq):
+        b0 = int(x / BIN)
+        sl = slice(max(b0 - 1, 0), min(b0 + 2, NBINS))
+        win = P[sl]
+
+        def wmed(col, ncol, ref=0.0, sign=1.0):
+            ok = win[:, ncol] >= 3
+            return (sign * (float(np.median(win[ok, col])) - ref)) if ok.any() else np.nan
+
+        lof, rof = wmed(1, 0, lref), wmed(3, 2, rref, -1.0)
+        midw = np.nanmean([lof, rof]) if np.isfinite([lof, rof]).any() else np.nan
+        a_, b_, c_ = fit_c
+        fwin = fc[sl][np.isfinite(fc[sl])]
+        rows.append([
+            x, st["curv"], st["tan_yaw"], st["center"], st["curv_step"], st["axis_valid"], x - st["axis_valid"],
+            st["rail_slabs"], st["axis_sides"], st["wall_quality"], float("curve_center" in st), co[i],
+            st.get("curve_valid", 0.0), fo_[i], bend[i],
+            lref, rref, lof, rof, midw, float(win[:, 0].sum()), float(win[:, 2].sum()), wmed(5, 4),
+            float(win[:, 4].sum()), wmed(7, 6), float(win[:, 6].sum()),
+            a_ + b_ * x + c_ * x * x, b_ + 2 * c_ * x, fit_last, fit_n, x - fit_last, fit_res, side_last_l,
+            side_last_r, lin[1] + lin[0] * x if np.isfinite(lin[0]) else np.nan,
+            float(np.mean(fwin)) if fwin.size else np.nan, float(fsd[sl].max()), f_last, x - f_last, f_n,
+            fq[0] + fq[1] * x + fq[2] * x * x, fl[1] + fl[0] * x if np.isfinite(fl[0]) else np.nan,
+            fq[1] + 2 * fq[2] * x, f_res,
+        ])
+    return np.asarray(rows, dtype=np.float64)
+
+
+class _Trees:
+    """One exported scikit-learn HistGradientBoostingRegressor: ``baseline`` plus the sum of its trees. A node with
+    ``left == -1`` is a leaf; ``x <= threshold`` goes left; NaN goes where ``missing_left`` says (as scikit-learn).
+    All trees are packed into flat node arrays and traversed together, one level per step."""
+
+    def __init__(self, spec: dict):
+        self.baseline = float(spec["baseline"])
+        trees = spec["trees"]
+        off = np.cumsum([0] + [len(t["value"]) for t in trees])[:-1]
+        cat = lambda k: np.concatenate([np.asarray(t[k]) for t in trees]) if trees else np.zeros(0)  # noqa: E731
+        self.feature = cat("feature").astype(np.int64)
+        self.threshold = cat("threshold").astype(np.float64)
+        self.value = cat("value").astype(np.float64)
+        self.missing_left = cat("missing_left").astype(bool)
+        left, right = cat("left").astype(np.int64), cat("right").astype(np.int64)
+        shift = np.concatenate([np.full(len(t["value"]), o) for t, o in zip(trees, off)]) if trees else np.zeros(0, np.int64)
+        self.leaf = left < 0
+        self.left = np.where(self.leaf, -1, left + shift)
+        self.right = np.where(self.leaf, -1, right + shift)
+        self.roots = off.astype(np.int64)
+
+    def predict(self, Xf: np.ndarray) -> np.ndarray:
+        n = Xf.shape[0]
+        if self.roots.size == 0:
+            return np.full(n, self.baseline)
+        node = np.broadcast_to(self.roots, (n, self.roots.size)).copy()
+        rows = np.broadcast_to(np.arange(n)[:, None], node.shape)
+        while True:
+            act = ~self.leaf[node]
+            if not act.any():
+                break
+            nd = node[act]
+            v = Xf[rows[act], self.feature[nd]]
+            go_left = np.where(np.isnan(v), self.missing_left[nd], v <= self.threshold[nd])
+            node[act] = np.where(go_left, self.left[nd], self.right[nd])
+        return self.baseline + self.value[node].sum(axis=1)
+
+
+class FarAxisModel:
+    """Quantile models of the axis residual (true centreline minus the base track model) read from JSON::
+
+        {"features": [...], "quantiles": [lo, mid, hi], "models": [{"baseline": b, "trees": [...]}, x3],
+         "query_x": [...], "margin": [...]}
+    """
+
+    def __init__(self, spec: dict):
+        self.features = list(spec["features"])
+        missing = [f for f in self.features if f not in FEATURES]
+        if missing:
+            raise ValueError(f"far-axis model uses unknown features {missing}")
+        self.cols = np.array([FEATURES.index(f) for f in self.features], dtype=np.int64)
+        self.quantiles = [float(q) for q in spec["quantiles"]]
+        self.models = [_Trees(m) for m in spec["models"]]
+        self.query_x = np.asarray(spec.get("query_x", QUERY_X), dtype=np.float64)
+        # split-conformal margins per query distance (from grouped out-of-fold residuals): the band is widened by
+        # this on both sides so that it covers the truth at the stated rate
+        self.margin = np.asarray(spec.get("margin", np.zeros(self.query_x.size)), dtype=np.float64)
+        self.x_col = FEATURES.index("x")
+
+    @classmethod
+    def load(cls, path: str) -> "FarAxisModel":
+        with open(path, encoding="utf-8") as fh:
+            return cls(json.load(fh))
+
+    def predict(self, F: np.ndarray) -> np.ndarray:
+        """(rows, 3): the lower, middle and upper residual quantile per feature row, sorted (no crossing), the lower
+        and upper ones moved out by the conformal margin at the row's query distance."""
+        F = np.asarray(F, dtype=np.float64)
+        Q = np.sort(np.stack([m.predict(F[:, self.cols]) for m in self.models], axis=1), axis=1)
+        m = np.interp(F[:, self.x_col], self.query_x, self.margin)
+        Q[:, 0] -= m
+        Q[:, 2] += m
+        return Q
+
+    def predict_raw(self, F: np.ndarray) -> np.ndarray:
+        """The three quantiles before the conformal margins."""
+        F = np.asarray(F, dtype=np.float64)
+        return np.sort(np.stack([m.predict(F[:, self.cols]) for m in self.models], axis=1), axis=1)
+
+
+_CACHE: dict = {}
+
+
+def load_model(path: str) -> Optional[FarAxisModel]:
+    """As ``resense.opinion.load_opinion``: absolute, a file in ``resense/models/``, or relative; cached."""
+    if not path:
+        return None
+    if path not in _CACHE:
+        packaged = os.path.join(os.path.dirname(os.path.abspath(__file__)), "models", path)
+        p = path if os.path.isabs(path) else packaged if os.path.exists(packaged) else path
+        _CACHE[path] = FarAxisModel.load(p)
+    return _CACHE[path]
+
+
+@dataclass
+class LearnedAxis:
+    """The learned centreline as an offset from the base model, used for the laterals on ``(from_x, to_x]``."""
+    xq: np.ndarray            # query distances
+    mid: np.ndarray           # predicted residual (true - base) per query distance
+    band: np.ndarray          # upper - lower quantile per query distance
+    from_x: float             # m: the learned offset applies beyond this (blended in over ``blend`` metres)
+    to_x: float               # m: ... up to here (0 = nowhere)
+    blend: float = 20.0
+
+    def offset(self, X: np.ndarray, model=None) -> np.ndarray:
+        """y_learned - y_base at X (0 outside ``(from_x, to_x]``): dy_learned = dy_base - offset."""
+        X = np.asarray(X, dtype=np.float64)
+        if self.to_x <= self.from_x:
+            return np.zeros(X.shape)
+        xs = np.concatenate([[0.0], self.xq])
+        ys = np.concatenate([[0.0], self.mid])
+        w = np.clip((X - self.from_x) / max(self.blend, 1e-6), 0.0, 1.0)
+        return np.where((X > self.from_x) & (X <= self.to_x), w * np.interp(X, xs, ys), 0.0)
+
+
+def learned_axis(model: FarAxisModel, prof: np.ndarray, st: dict, from_x: float, max_band: float,
+                 range_max: float) -> tuple:
+    """(LearnedAxis, Q): the trusted learned stretch from ``from_x`` to the farthest query distance whose band
+    (upper minus lower quantile) is at most ``max_band``, every query distance between ``from_x`` and it included."""
+    xq = model.query_x
+    Q = model.predict(query_features(prof, st, xq))
+    band = Q[:, 2] - Q[:, 0]
+    to = 0.0
+    for x, b in zip(xq, band):
+        if x <= from_x:
+            continue
+        if b > max_band or x > range_max:
+            break
+        to = float(x)
+    return LearnedAxis(xq=xq, mid=Q[:, 1], band=band, from_x=float(from_x), to_x=to), Q
