Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 10
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR
      Topic:
        Value: /lidar_points
        Reliability Policy: Best Effort
        History Policy: Keep Last
        Depth: 5
      Color Transformer: AxisColor
      Axis: Z
      Min Color: 0; 0; 0
      Max Color: 255; 255; 255
      Size (Pixels): 1.5
      Style: Points
      Alpha: 0.6
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Corridor points
      Topic:
        Value: /resense/corridor_points
        Reliability Policy: Reliable
      Color Transformer: FlatColor
      Color: 255; 170; 0
      Size (Pixels): 4
      Style: Points
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Detections
      Topic:
        Value: /resense/markers
      Value: true
  Global Options:
    Background Color: 20; 20; 24
    Fixed Frame: hesai_lidar
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 90
      Focal Point:
        X: 0
        Y: -60
        Z: 0
      Pitch: 0.45
      Yaw: 1.57
      Name: Current View
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 900
  Width: 1500
